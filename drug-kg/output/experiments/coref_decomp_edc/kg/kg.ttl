ns1:build_up_in a rdf:Property ;
    rdfs:label "build up in" ;
    rdfs:comment "The subject entity accumulates or increases in the location or system specified by the object entity." .

ns1:can_be a rdf:Property ;
    rdfs:label "can be" ;
    rdfs:comment "The subject condition or entity may be characterized by the object condition or entity." .

ns1:can_be_reached_at a rdf:Property ;
    rdfs:label "can be reached at" ;
    rdfs:comment "The subject entity can be contacted or accessed through the phone number specified by the object entity." .

