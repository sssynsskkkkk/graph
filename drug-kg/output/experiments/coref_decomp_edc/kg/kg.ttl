ns1:belongs_to_drug_class a rdf:Property ;
    rdfs:label "belongs to drug class" ;
    rdfs:comment "The subject drug is a member of the pharmacological or therapeutic drug class specified by the object entity." .

ns1:blocks a rdf:Property ;
