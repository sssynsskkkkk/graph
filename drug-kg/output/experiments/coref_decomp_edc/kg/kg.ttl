    rdfs:comment "The subject condition or symptom is caused by the object condition or factor." .

ns1:causes_false_positive_results_in a rdf:Property ;
    rdfs:label "causes false positive results in" ;
    rdfs:comment "The subject substance may lead to incorrect positive results in the test or assay specified by the object entity." .

ns1:compared_with a rdf:Property ;
    rdfs:label "compared with" ;
    rdfs:comment "The subject drug was compared to the other drug or substance in a study." .

ns1:contains_ingredient a rdf:Property ;
