    rdfs:comment "The subject entity is receiving treatment with the substance or therapy specified by the object entity." .

ns1:are_copies_of a rdf:Property ;
    rdfs:label "are copies of" ;
    rdfs:comment "The subject entity is a synthetic or artificial version of the entity specified by the object entity." .

ns1:available_by a rdf:Property ;
    rdfs:label "available by" ;
    rdfs:comment "The subject drug is obtainable through the method or requirement specified by the object entity." .

ns1:average_starting_weight a rdf:Property ;
