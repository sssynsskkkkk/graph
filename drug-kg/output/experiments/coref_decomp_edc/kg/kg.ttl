        <http://drugkg.example.org/entity/call_your_doctor_at_once_if_you_have_chest_pain_fast_heart_rate_pounding_heartbeats_or_fluttering_in_your_chest>,
        <http://drugkg.example.org/entity/call_your_doctor_at_once_if_you_have_pain_or_burning_when_you_urinate>,
        <http://drugkg.example.org/entity/call_your_doctor_at_once_if_you_have_wheezing_choking_or_other_breathing_problems_after_using_albuterol>,
        <http://drugkg.example.org/entity/call_your_doctor_for_medical_advice_about_side_effects>,
        <http://drugkg.example.org/entity/clean_the_plastic_actuator_with_the_canister_removed_at_least_once_a_week>,
        <http://drugkg.example.org/entity/do_not_allow_a_young_child_to_use_albuterol_inhalation_without_help_from_an_adult>,
        <http://drugkg.example.org/entity/do_not_change_doses_or_medication_schedule_without_doctor_s_advice>,
        <http://drugkg.example.org/entity/do_not_float_a_medicine_canister_in_water_to_see_if_medicine_canister_is_empty>,
        <http://drugkg.example.org/entity/do_not_use_in_larger_or_smaller_amounts_or_for_longer_than_recommended>,
        <http://drugkg.example.org/entity/follow_all_directions_on_your_prescription_label>,
        <http://drugkg.example.org/entity/follow_all_medication_instructions_very_carefully>,
        <http://drugkg.example.org/entity/follow_all_product_instructions_on_how_to_clean_your_albuterol_inhaler_device_and_mouthpiece>,
        <http://drugkg.example.org/entity/get_your_prescription_refilled_before_you_run_out_of_medicine_completely>,
