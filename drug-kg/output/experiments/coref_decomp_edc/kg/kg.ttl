ns1:acts_in a rdf:Property ;
    rdfs:label "acts in" ;
    rdfs:comment "The subject drug exerts its effects within the anatomical or physiological system specified by the object entity." .

ns1:administered_via a rdf:Property ;
    rdfs:label "administered via" ;
    rdfs:comment "The subject drug is given through the route of administration specified by the object entity." .

ns1:affects a rdf:Property ;
    rdfs:label "affects" ;
    rdfs:comment "The subject substance influences or alters the object entity, typically through biochemical or physiological mechanisms." .

ns1:allows a rdf:Property ;
    rdfs:label "allows" ;
    rdfs:comment "The subject method or regimen enables the process or function specified by the object entity." .

ns1:applies_to_patients_who_are_to_be_managed_with a rdf:Property ;
    rdfs:label "applies to patients who are to be managed with" ;
    rdfs:comment "The subject drug is used for patients who are managed with the procedure or treatment specified by the object entity." .

ns1:are_being_treated_with a rdf:Property ;
