        <http://drugkg.example.org/entity/cut_back_on_salt>,
        <http://drugkg.example.org/entity/do_not_adjust_dose_yourself>,
        <http://drugkg.example.org/entity/do_not_have_live_vaccine_without_doctor_approval>,
        <http://drugkg.example.org/entity/do_not_stop_suddenly_after_more_than_a_few_days>,
        <http://drugkg.example.org/entity/follow_instructions_on_pack_exactly>,
        <http://drugkg.example.org/entity/limit_alcohol_intake>,
