ns1:achieves_hba1c_below_7 a rdf:Property ;
    rdfs:label "achieves hba1c below 7%" ;
    rdfs:comment "A specified proportion of patients using the subject intervention achieve an HbA1c level below 7%." .

ns1:administered_via a rdf:Property ;
    rdfs:label "administered via" ;
    rdfs:comment "The subject drug is given through the route of administration specified by the object entity." .

ns1:affects a rdf:Property ;
    rdfs:label "affects" ;
    rdfs:comment "The condition specified by the object entity impacts a certain proportion or group of individuals specified by the subject entity." .

ns1:are_supported_by a rdf:Property ;
    rdfs:label "are supported by" ;
    rdfs:comment "The subject entity are supported by the object entity." .

ns1:belongs_to_drug_class a rdf:Property ;
    rdfs:label "belongs to drug class" ;
    rdfs:comment "The subject drug is a member of the pharmacological or therapeutic drug class specified by the object entity." .

ns1:can_cause_damage_to a rdf:Property ;
    rdfs:label "can cause damage to" ;
    rdfs:comment "The condition specified by the object entity may result in physical or functional damage to the organ or tissue specified by the subject entity." .

ns1:can_occur_with a rdf:Property ;
    rdfs:label "can occur with" ;
    rdfs:comment "The subject drug can be present in individuals who also have the condition specified by the object entity." .

ns1:can_pass_into a rdf:Property ;
    rdfs:label "can pass into" ;
    rdfs:comment "The subject drug can transfer into the biological fluid or substance specified by the object entity." .

ns1:caused_by a rdf:Property ;
    rdfs:label "caused by" ;
    rdfs:comment "The condition specified by the object entity is a contributing factor leading to the occurrence of the condition specified by the subject entity." .

ns1:contains_ingredient a rdf:Property ;
    rdfs:label "contains ingredient" ;
    rdfs:comment "The subject drug product contains the active ingredient specified by the object entity." .

ns1:contraindicated_in a rdf:Property ;
    rdfs:label "contraindicated in" ;
    rdfs:comment "The subject drug should not be used by patients who have the condition or characteristic specified by the object entity." .

ns1:delivers a rdf:Property ;
    rdfs:label "delivers" ;
    rdfs:comment "The subject device or formulation administers the specified amount or type of substance." .

ns1:distributed_from a rdf:Property ;
    rdfs:label "distributed from" ;
    rdfs:comment "The subject drug brand is distributed or licensed from the company specified by the object entity." .

ns1:does_not_affect a rdf:Property ;
    rdfs:label "does not affect" ;
    rdfs:comment "The subject drug has no impact on the condition or parameter specified by the object entity." .

ns1:does_not_demonstrate_superiority a rdf:Property ;
    rdfs:label "does not demonstrate superiority" ;
    rdfs:comment "The subject drug does not show better effectiveness than the object drug in the specified clinical outcome." .

ns1:does_not_inhibit a rdf:Property ;
    rdfs:label "does not inhibit" ;
    rdfs:comment "The subject drug does not block or inhibit the activity of the enzyme or process specified by the object entity." .

ns1:does_not_reduce_risk_of a rdf:Property ;
    rdfs:label "does not reduce risk of" ;
    rdfs:comment "The subject drug does not lower the risk of the medical condition or event specified by the object entity." .

ns1:dose_for_children a rdf:Property ;
    rdfs:label "dose for children" ;
    rdfs:comment "The dosing of the subject drug for children is determined primarily by the condition and must be prescribed by a medical professional." .

ns1:dose_not_affected_by a rdf:Property ;
    rdfs:label "dose not affected by" ;
    rdfs:comment "The subject drug's dosage does not need to be adjusted in patients with the condition specified by the object entity." .

ns1:fda_approval_year a rdf:Property ;
    rdfs:label "fda approval year" ;
    rdfs:comment "The subject drug was approved by the US FDA in the year specified by the object entity." .

ns1:has_administration_instruction a rdf:Property ;
    rdfs:label "has administration instruction" ;
    rdfs:comment "The subject drug should be taken or used in the manner specified by the object entity (for example with food or at a fixed time)." .

ns1:has_all_cause_death_rate a rdf:Property ;
    rdfs:label "has all cause death rate" ;
    rdfs:comment "The subject drug has the specified rate of death from any cause in the study population." .

ns1:has_alternative_therapy_if_stopped a rdf:Property ;
    rdfs:label "has alternative therapy if stopped" ;
    rdfs:comment "If the subject drug is discontinued, the patient should be prescribed the therapy specified by the object entity to maintain treatment efficacy." .

ns1:has_animal_study_finding a rdf:Property ;
    rdfs:label "has animal study finding" ;
    rdfs:comment "In animal studies, the subject drug was observed to cause the condition or outcome specified by the object entity." .

ns1:has_availability a rdf:Property ;
    rdfs:label "has availability" ;
    rdfs:comment "The subject drug is available under the regulatory status specified by the object entity (for example prescription only or over the counter)." .

ns1:has_availability_status a rdf:Property ;
    rdfs:label "has availability status" ;
    rdfs:comment "The subject drug is available in the market under the specified availability condition." .

ns1:has_biosimilar a rdf:Property ;
