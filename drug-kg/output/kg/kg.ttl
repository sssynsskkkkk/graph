        <http://drugkg.example.org/entity/systemic_fungal_infection> ;
    ns1:dose_for_children <http://drugkg.example.org/entity/must_be_set_by_doctor> ;
    ns1:dose_not_affected_by <http://drugkg.example.org/entity/treatment_less_than_3_to_4_weeks> ;
    ns1:has_administration_instruction <http://drugkg.example.org/entity/ask_doctor_about_bone_density_scan>,
        <http://drugkg.example.org/entity/ask_doctor_about_calcium_and_vitamin_d_supplement>,
        <http://drugkg.example.org/entity/avoid_being_near_sick_people>,
        <http://drugkg.example.org/entity/avoid_close_contact_with_people_who_have_had_live_vaccines>,
        <http://drugkg.example.org/entity/avoid_contact_with_sick_people>,
        <http://drugkg.example.org/entity/call_doctor_for_side_effect_advice>,
