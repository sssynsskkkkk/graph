    rdfs:comment "A biological product is a biosimilar of another approved biological product, meaning it is highly similar and has no clinically meaningful differences from the reference product." .

ns1:has_boxed_warning a rdf:Property ;
    rdfs:label "has boxed warning" ;
    rdfs:comment "The subject drug carries an official boxed (black box) safety warning about the risk specified by the object entity." .

ns1:has_brand_name a rdf:Property ;
    rdfs:label "has brand name" ;
    rdfs:comment "The subject drug is marketed under the brand or trade name specified by the object entity." .

ns1:has_contraindicated_route a rdf:Property ;
    rdfs:label "has contraindicated route" ;
    rdfs:comment "The subject medication should not be administered through the specified route, such as intramuscular or intravenous injection." .

