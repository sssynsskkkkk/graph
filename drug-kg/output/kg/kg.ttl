ns1:has_repeat_course_interval_restriction a rdf:Property ;
    rdfs:label "has repeat course interval restriction" ;
    rdfs:comment "The subject drug should not be restarted within the specified time period unless prescribed by a doctor." .

ns1:has_risk_variation_by_age_group a rdf:Property ;
    rdfs:label "has risk variation by age group" ;
    rdfs:comment "The risk associated with the subject drug varies across different age groups, as specified in the object entity." .

ns1:has_salt_form a rdf:Property ;
    rdfs:label "has salt form" ;
    rdfs:comment "The subject compound is a salt form of the active substance specified by the object entity." .

ns1:has_serious_side_effect a rdf:Property ;
    rdfs:label "has serious side effect" ;
    rdfs:comment "The subject drug may cause the serious or potentially dangerous adverse effect specified by the object entity that requires medical attention." .

ns1:has_shelf_life_after_opening a rdf:Property ;
    rdfs:label "has shelf life after opening" ;
    rdfs:comment "The subject drug remains effective for the duration specified by the object entity after the packaging is opened." .

ns1:has_side_effect a rdf:Property ;
    rdfs:label "has side effect" ;
    rdfs:comment "The subject drug may cause the adverse effect or symptom specified by the object entity." .

ns1:has_side_effect_prevalence a rdf:Property ;
    rdfs:label "has side effect prevalence" ;
    rdfs:comment "The proportion of patients experiencing the specified side effect at the given dose or condition is reported." .

ns1:has_side_effect_resolution_after a rdf:Property ;
    rdfs:label "has side effect resolution after" ;
    rdfs:comment "The adverse effect specified by the object entity typically resolves after the subject drug is stopped or the dose is lowered." .

ns1:has_side_effect_variation a rdf:Property ;
    rdfs:label "has side effect variation" ;
    rdfs:comment "The occurrence or severity of side effects from the subject drug may be influenced by the object entity." .

ns1:has_storage_instruction a rdf:Property ;
    rdfs:label "has storage instruction" ;
    rdfs:comment "The subject drug should be stored according to the instruction specified by the object entity." .

ns1:has_strength a rdf:Property ;
    rdfs:label "has strength" ;
    rdfs:comment "The subject drug is available in the dose strength specified by the object entity." .

ns1:has_sustained_weight_loss_phase a rdf:Property ;
    rdfs:label "has sustained weight loss phase" ;
    rdfs:comment "The subject drug leads to ongoing and maintained weight loss over the duration specified by the object entity." .

ns1:has_test_interference_effect a rdf:Property ;
    rdfs:label "has test interference effect" ;
    rdfs:comment "The subject drug may cause a false positive or false negative result in the specified diagnostic test." .

ns1:has_treatment_guidance a rdf:Property ;
    rdfs:label "has treatment guidance" ;
    rdfs:comment "The continuation or adjustment of treatment with the subject drug should be based on the relative benefits and risks for the individual patient as specified by the object entity." .

ns1:has_typical_weight_gain a rdf:Property ;
    rdfs:label "has typical weight gain" ;
    rdfs:comment "The subject drug is associated with a typical amount of weight gain specified by the object entity over a given time period." .

ns1:has_unclear_mechanism_of_action a rdf:Property ;
    rdfs:label "has unclear mechanism of action" ;
    rdfs:comment "The exact way the subject drug exerts its effect on the specified condition is not fully understood." .

ns1:has_unit_of_measure a rdf:Property ;
    rdfs:label "has unit of measure" ;
    rdfs:comment "The subject drug is measured in the unit specified by the object entity, which is critical for accurate dosing." .

ns1:has_unknown_passage_into a rdf:Property ;
    rdfs:label "has unknown passage into" ;
    rdfs:comment "It is not known whether the subject drug passes into the specified biological medium, such as breast milk." .

ns1:has_unknown_risk_duration a rdf:Property ;
    rdfs:label "has unknown risk duration" ;
    rdfs:comment "The risk associated with the subject drug is not known to continue beyond the specified duration of treatment." .

ns1:has_warning a rdf:Property ;
    rdfs:label "has warning" ;
    rdfs:comment "The subject drug carries a safety warning or precaution about the risk or situation specified by the object entity." .

ns1:has_weak_effect_on a rdf:Property ;
    rdfs:label "has weak effect on" ;
    rdfs:comment "The subject drug has only minimal or very weak effects on the reuptake of the neurotransmitter or chemical specified by the object entity." .

ns1:has_weight_loss_outcome a rdf:Property ;
    rdfs:label "has weight loss outcome" ;
    rdfs:comment "The subject drug is associated with specific weight loss results in clinical studies, including percentage of body weight lost over time and proportions of patients achieving significant weight reduction." .

ns1:has_withdrawal_symptom a rdf:Property ;
    rdfs:label "has withdrawal symptom" ;
    rdfs:comment "When the subject drug is stopped abruptly, the patient may experience the symptom specified by the object entity." .

ns1:includes a rdf:Property ;
    rdfs:label "includes" ;
    rdfs:comment "The activity or intervention specified by the subject entity comprises the component or practice specified by the object entity." .

ns1:increases_level_of a rdf:Property ;
    rdfs:label "increases level of" ;
    rdfs:comment "The subject drug increases the level of the substance or biomarker specified by the object entity in the body." .

ns1:increases_risk_of a rdf:Property ;
    rdfs:label "increases risk of" ;
    rdfs:comment "Taking the subject drug may raise the patient's likelihood of experiencing the condition or event specified by the object entity." .

ns1:interacts_with a rdf:Property ;
    rdfs:label "interacts with" ;
    rdfs:comment "The subject drug has a drug interaction with the drug or substance specified by the object entity that may change effects or cause harm." .

ns1:is_discontinued a rdf:Property ;
    rdfs:label "is discontinued" ;
    rdfs:comment "The subject drug product is no longer available for sale or use, specifically for the drug specified by the object entity." .

ns1:lowers_level_of a rdf:Property ;
    rdfs:label "lowers level of" ;
    rdfs:comment "The subject drug decreases the level of the substance or biomarker specified by the object entity in the body." .

ns1:manufactured_by a rdf:Property ;
    rdfs:label "manufactured by" ;
    rdfs:comment "The subject drug is manufactured or marketed by the company specified by the object entity." .

ns1:may_be_listed_on a rdf:Property ;
    rdfs:label "may be listed on" ;
    rdfs:comment "The subject drug may result in the patient's name being included in the registry specified by the object entity." .

ns1:may_reduce_response_to a rdf:Property ;
    rdfs:label "may reduce response to" ;
    rdfs:comment "The subject drug may diminish the physiological or therapeutic response to the medication specified by the object entity." .

ns1:may_require_dose_adjustment a rdf:Property ;
    rdfs:label "may require dose adjustment" ;
    rdfs:comment "The subject medication might need a change in dosage under certain conditions or over time." .

ns1:may_require_temporary_discontinuation_before a rdf:Property ;
    rdfs:label "may require temporary discontinuation before" ;
    rdfs:comment "The subject medication might need to be stopped temporarily prior to undergoing the specified medical procedure." .

ns1:may_show_up_on_drug_test a rdf:Property ;
    rdfs:label "may show up on drug test" ;
    rdfs:comment "The subject drug can be detected in drug tests as indicated by the object entity." .

ns1:mimics_symptoms_of a rdf:Property ;
    rdfs:label "mimics symptoms of" ;
    rdfs:comment "The subject condition or drug may present symptoms that resemble those of the medical condition specified by the object entity." .

ns1:monitors_through a rdf:Property ;
    rdfs:label "monitors through" ;
    rdfs:comment "The subject drug's therapeutic response is evaluated by regularly measuring the specified biological parameter." .

ns1:must_be_started_after a rdf:Property ;
    rdfs:label "must be started after" ;
    rdfs:comment "The subject drug should be initiated only after the treatment specified by the object entity has begun." .

ns1:not_approved_for a rdf:Property ;
    rdfs:label "not approved for" ;
    rdfs:comment "The subject drug is not approved or not recommended for use in the patient population specified by the object entity." .

ns1:not_chemically_related_to a rdf:Property ;
    rdfs:label "not chemically related to" ;
    rdfs:comment "The subject drug does not share a chemical structure or relationship with the substance specified by the object entity." .

ns1:not_eligible_for_savings_card a rdf:Property ;
    rdfs:label "not eligible for savings card" ;
    rdfs:comment "Patients with the specified condition or insurance type are not eligible to access the savings card for the subject drug." .

ns1:not_used_to_treat a rdf:Property ;
    rdfs:label "not used to treat" ;
    rdfs:comment "The subject drug is inappropriate or contraindicated for the treatment of the condition specified by the object entity." .

ns1:reaches_maximum_acid_lowering_effect a rdf:Property ;
    rdfs:label "reaches maximum acid lowering effect" ;
    rdfs:comment "The subject drug attains its highest level of acid reduction at the time specified by the object entity." .

ns1:reduces_risk_of a rdf:Property ;
    rdfs:label "reduces risk of" ;
    rdfs:comment "The subject drug is used to prevent or lower the risk of the medical event or condition specified by the object entity." .

ns1:requires_doctor_consultation_before_discontinuation a rdf:Property ;
    rdfs:label "requires doctor consultation before discontinuation" ;
    rdfs:comment "The subject drug should not be stopped abruptly without medical advice to prevent potentially harmful withdrawal effects." .

ns1:requires_gradual_dose_reduction a rdf:Property ;
    rdfs:label "requires gradual dose reduction" ;
    rdfs:comment "The subject drug must be reduced in dose slowly over the time period specified by the object entity to avoid adverse effects." .

ns1:requires_monitoring_of a rdf:Property ;
    rdfs:label "requires monitoring of" ;
    rdfs:comment "Patients taking the subject drug may need the medical test or monitoring specified by the object entity." .

ns1:requires_patient_adherence_to a rdf:Property ;
    rdfs:label "requires patient adherence to" ;
    rdfs:comment "Patients must consistently follow the lifestyle or treatment regimen specified by the object entity to achieve optimal outcomes." .

ns1:requires_patient_to_provide_full_medication_list_to a rdf:Property ;
    rdfs:label "requires patient to provide full medication list to" ;
    rdfs:comment "Patients using the subject drug must provide a complete list of all medications, including prescription, over-the-counter, and herbal products, to any healthcare provider." .

ns1:requires_patient_to_read a rdf:Property ;
    rdfs:label "requires patient to read" ;
    rdfs:comment "The patient is required to review the specified educational materials or documentation related to the medication." .

ns1:requires_prescriber_decision a rdf:Property ;
    rdfs:label "requires prescriber decision" ;
    rdfs:comment "The change in drug form or treatment requires authorization or decision-making by the prescribing healthcare provider, not by the patient." .

ns1:requires_use_of a rdf:Property ;
    rdfs:label "requires use of" ;
    rdfs:comment "The subject drug requires patients to use the specified product or practice to ensure safety or effectiveness." .

ns1:requires_waiting_period_before_repeat_course a rdf:Property ;
    rdfs:label "requires waiting period before repeat course" ;
    rdfs:comment "A minimum period of time must pass before restarting a new course of treatment with the subject medication." .

ns1:should_be_avoided_with a rdf:Property ;
    rdfs:label "should be avoided with" ;
    rdfs:comment "Patients taking the subject drug should avoid the substance or activity specified by the object entity." .

ns1:should_inform_doctor_about a rdf:Property ;
    rdfs:label "should inform doctor about" ;
    rdfs:comment "Patients taking the subject drug should tell their doctor about the condition or circumstance specified by the object entity." .

ns1:should_not_be_stopped_during a rdf:Property ;
    rdfs:label "should not be stopped during" ;
    rdfs:comment "The subject drug must be continued without interruption during the specified condition or activity." .

ns1:should_not_be_stored_in a rdf:Property ;
    rdfs:label "should not be stored in" ;
    rdfs:comment "The subject drug should not be kept in the object entity, as this may lead to degradation or loss of efficacy." .

ns1:should_not_be_taken a rdf:Property ;
    rdfs:label "should not be taken" ;
    rdfs:comment "The subject medication should not be consumed in the amount or duration specified by the object entity." .

ns1:similar_to a rdf:Property ;
    rdfs:label "similar to" ;
    rdfs:comment "The subject drug is related to or an alternative for the drug specified by the object entity." .

ns1:slows_digestion a rdf:Property ;
    rdfs:label "slows digestion" ;
    rdfs:comment "The subject drug reduces the rate at which food and oral medications are digested, thereby delaying the absorption of orally administered medicines." .

ns1:stopping_may_increase_risk_of a rdf:Property ;
    rdfs:label "stopping may increase risk of" ;
    rdfs:comment "Discontinuing the subject drug may lead to an increased risk of the medical event or condition specified by the object entity." .

ns1:treats a rdf:Property ;
    rdfs:label "treats" ;
    rdfs:comment "The subject drug is used to treat or manage the disease or medical condition specified by the object entity." .

ns1:use_with_caution_in a rdf:Property ;
    rdfs:label "use with caution in" ;
    rdfs:comment "The subject drug may be unsafe or require medical supervision for patients who have the condition or characteristic specified by the object entity." .

ns1:used_in_combination_with a rdf:Property ;
    rdfs:label "used in combination with" ;
    rdfs:comment "The subject drug is used together with the other treatment or lifestyle measure specified by the object entity." .

ns1:used_in_population a rdf:Property ;
    rdfs:label "used in population" ;
    rdfs:comment "The subject drug is used in or approved for the patient population or age group specified by the object entity." .

