      "section_title": "How does gabapentin work?",
      "line_start": 29,
      "line_end": 29,
      "evidence_char_start": 3325,
      "evidence_char_end": 3633,
      "evidence_text": "Gabapentin works by calming overactive electrical signals in the brain and nervous system. It does this by binding to the alpha-2-delta subunit of calcium channels in nerve cells, which is thought to normalize chemical signals nerves send to each other and results in a calmer, less excitable nerve circuit.\n",
      "additional_context": [],
      "passage_id": "rank11_L029_029",
      "source_record_ids": [
        "gabapentin.txt|29|0|2800",
        "gabapentin.txt|29|1|2801"
      ]
    },
